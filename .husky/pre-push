# Refuses any direct push to main: the workflow requires a PR.
# A local copy of the GitHub ruleset, which remains the authority on the server.
protected="main"
while read -r _local_ref _local_sha remote_ref _remote_sha; do
	case "$remote_ref" in
		"refs/heads/$protected")
			echo "pre-push: direct push to '$protected' refused."
			echo "Open a PR from a feat/ fix/ chore/ docs/ ci/ refactor/ test/ branch."
			exit 1
			;;
	esac
done
