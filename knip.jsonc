// Zero-base rule: every file, export and dependency is either consumed,
// generated, or listed here with the reason it stays. `npm run knip` must
// report nothing; CI fails otherwise.
{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      // The package.json scripts are found by knip's plugins. The registry
      // items are entry points on top of that: consumers install them with the
      // shadcn CLI, so every file and export they ship is public API even when
      // nothing in this repository imports it.
      "entry": [
        "components/ui/*.tsx",
        "hooks/*.ts",
        "lib/{focus,overlay,surface,ui-strings,utils}.ts",
        // The source of the registry:font items and of tokens:lint-fonts, both
        // of which read it as text.
        "lib/fonts.ts",
        // The base item's stylesheet: the tokens, the @theme bridge and the
        // lockdown. Consumers import it; nothing here does.
        "styles/globals.css",
        // Loaded by Terrazzo in scripts/lint-dtcg.ts; knip has no Terrazzo plugin.
        "terrazzo.config.ts",
        // Stage B of the conformance harness: run by evals/run.ts through
        // `vitest --config`, which knip's Vitest plugin does not follow.
        "evals/a11y/vitest.config.ts",
        "evals/a11y/screens.test.tsx",
      ],
      // Screens wrong on purpose, replayed by `npm run evals:test`, and the
      // screens the change tasks start from, read as text by evals/lib/tasks.ts.
      "ignore": ["evals/fixtures/**", "evals/bases/**"],
      "project": [
        "{components,hooks,lib,scripts,tests,evals,site}/**/*.{ts,tsx}",
        "styles/*.css",
        "site/**/*.css",
        "*.{ts,mjs}",
      ],
      // The documentation site is a Next.js app in site/, which knip's Next.js
      // and PostCSS plugins only look for at the workspace root.
      "next": {
        "config": ["site/next.config.ts"],
        "entry": [
          "site/app/**/{page,layout,not-found,error,loading,template,default}.tsx",
        ],
      },
      "postcss": { "config": ["site/postcss.config.mjs"] },
    },
    "packages/eslint-plugin": {
      // The package.json scripts (build, test) are found by knip; `main` and
      // `exports` point at dist/, which knip maps back to src/index.ts.
      "project": ["src/**/*.ts"],
    },
    "mcp-server": {
      // `bin` (src/index.ts) and the package.json scripts are found by knip.
      "project": ["src/**/*.ts"],
    },
  },
}
