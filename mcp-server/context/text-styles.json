{
  "font_families": [
    {
      "token": "typography.font-family.mono",
      "css_variable": "--typography-font-family-mono",
      "family": "JetBrains Mono",
      "tailwind_class": "font-mono",
      "usage": "The application's default typeface — all UI text"
    },
    {
      "token": "typography.font-family.sans",
      "css_variable": "--typography-font-family-sans",
      "family": "Geist Sans",
      "tailwind_class": "font-sans",
      "usage": "Kbd keys and long editorial content; never for the interface"
    }
  ],
  "type_scale": [
    {
      "token": "typography.size.xs",
      "css_variable": "--typography-size-xs",
      "rem": "0.75rem",
      "px": "12 px",
      "tailwind_class": "text-xs",
      "usage": "Component text: labels (Label, FieldLabel), buttons, inputs, badges, menu items, descriptions, chart legends"
    },
    {
      "token": "typography.size.sm",
      "css_variable": "--typography-size-sm",
      "rem": "0.875rem",
      "px": "14 px",
      "tailwind_class": "text-sm",
      "usage": "Titles inside a component (CardTitle, DialogTitle…), the FieldLegend legend, a screen's secondary text"
    },
    {
      "token": "typography.size.base",
      "css_variable": "--typography-size-base",
      "rem": "1rem",
      "px": "16 px",
      "tailwind_class": "text-base",
      "usage": "Main body text; Heading level 4"
    },
    {
      "token": "typography.size.lg",
      "css_variable": "--typography-size-lg",
      "rem": "1.125rem",
      "px": "18 px",
      "tailwind_class": "text-lg",
      "usage": "Emphasized body text, introductions; Heading level 3"
    },
    {
      "token": "typography.size.xl",
      "css_variable": "--typography-size-xl",
      "rem": "1.25rem",
      "px": "20 px",
      "tailwind_class": "text-xl",
      "usage": "Heading level 2: section headings"
    },
    {
      "token": "typography.size.2xl",
      "css_variable": "--typography-size-2xl",
      "rem": "1.5rem",
      "px": "24 px",
      "tailwind_class": "text-2xl",
      "usage": "Heading level 1: the page title"
    },
    {
      "token": "typography.size.3xl",
      "css_variable": "--typography-size-3xl",
      "rem": "1.875rem",
      "px": "30 px",
      "tailwind_class": "text-3xl",
      "usage": "Hero text a screen draws; no component uses it"
    },
    {
      "token": "typography.size.4xl",
      "css_variable": "--typography-size-4xl",
      "rem": "2.25rem",
      "px": "36 px",
      "tailwind_class": "text-4xl",
      "usage": "Display text a screen draws, rare; no component uses it"
    }
  ],
  "line_heights": [
    {
      "token": "typography.line-height.tight",
      "css_variable": "--typography-line-height-tight",
      "value": "1.25",
      "tailwind_class": "leading-tight",
      "usage": "Short text on 1 or 2 lines"
    },
    {
      "token": "typography.line-height.snug",
      "css_variable": "--typography-line-height-snug",
      "value": "1.375",
      "tailwind_class": "leading-snug",
      "usage": "Multi-line labels: FieldLabel draws it"
    },
    {
      "token": "typography.line-height.normal",
      "css_variable": "--typography-line-height-normal",
      "value": "1.5",
      "tailwind_class": "leading-normal",
      "usage": "Default body text"
    },
    {
      "token": "typography.line-height.relaxed",
      "css_variable": "--typography-line-height-relaxed",
      "value": "1.625",
      "tailwind_class": "leading-relaxed",
      "usage": "Long-form text, articles"
    },
    {
      "token": "typography.line-height.loose",
      "css_variable": "--typography-line-height-loose",
      "value": "2",
      "tailwind_class": "leading-loose",
      "usage": "Very airy text — seldom used"
    }
  ],
  "font_weights": [
    {
      "token": "typography.font-weight.normal",
      "css_variable": "--typography-font-weight-normal",
      "value": "400",
      "tailwind_class": "font-normal",
      "usage": "Body text, labels (Label, FieldLabel), descriptions"
    },
    {
      "token": "typography.font-weight.medium",
      "css_variable": "--typography-font-weight-medium",
      "value": "500",
      "tailwind_class": "font-medium",
      "usage": "Buttons, tabs, badges, component titles (CardTitle, DialogTitle…), table headers"
    },
    {
      "token": "typography.font-weight.semibold",
      "css_variable": "--typography-font-weight-semibold",
      "value": "600",
      "tailwind_class": "font-semibold",
      "usage": "Headings — Heading draws it at every level"
    },
    {
      "token": "typography.font-weight.bold",
      "css_variable": "--typography-font-weight-bold",
      "value": "700",
      "tailwind_class": "font-bold",
      "usage": "Strong emphasis a screen draws; the Logo"
    }
  ],
  "letter_spacings": [
    {
      "token": "typography.letter-spacing.tight",
      "css_variable": "--typography-letter-spacing-tight",
      "value": "-0.025em",
      "tailwind_class": "tracking-tight",
      "usage": "Headings — Heading draws it at every level"
    },
    {
      "token": "typography.letter-spacing.normal",
      "css_variable": "--typography-letter-spacing-normal",
      "value": "0em",
      "tailwind_class": "tracking-normal",
      "usage": "Running text — the default"
    },
    {
      "token": "typography.letter-spacing.wide",
      "css_variable": "--typography-letter-spacing-wide",
      "value": "0.025em",
      "tailwind_class": "tracking-wide",
      "usage": "Captions a screen draws; no component uses it"
    },
    {
      "token": "typography.letter-spacing.wider",
      "css_variable": "--typography-letter-spacing-wider",
      "value": "0.05em",
      "tailwind_class": "tracking-wider",
      "usage": "All-caps text, overlines; no component uses it"
    },
    {
      "token": "typography.letter-spacing.widest",
      "css_variable": "--typography-letter-spacing-widest",
      "value": "0.1em",
      "tailwind_class": "tracking-widest",
      "usage": "Keyboard shortcuts in menus and Command"
    }
  ],
  "usage_rules": [
    "**JetBrains Mono is the default typeface** — never override `font-family` on standard UI components without design approval.",
    "**A heading is a `Heading`, a field label a `FieldLabel`** — each draws its own size, weight, tracking and line height, so pass it no `text-*`, `font-*`, `tracking-*` or `leading-*` class. For text a screen draws itself, a `text-*` class already carries its paired line height: add `leading-*` only to change it.",
    "**`tracking-tight` belongs to headings** — `Heading` draws it at every level; on running text, negative spacing hurts readability.",
    "**`tracking-wider` is for all-caps only** — never use it on regular lowercase text. `tracking-widest` is for keyboard shortcuts only.",
    "**A strict weight hierarchy** — `normal` → body text, labels and descriptions, `medium` → buttons, tabs, badges and component titles, `semibold` → headings, `bold` → strong emphasis a screen draws. A field label stays `normal`."
  ]
}