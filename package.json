{
  "name": "dsaireadable",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "workspaces": [
    ".",
    "packages/*",
    "mcp-server"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0",
    "lint:language": "tsx scripts/lint-language.ts",
    "knip": "knip",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:mcp": "tsc --noEmit -p mcp-server",
    "typecheck:plugin": "tsc --noEmit -p packages/eslint-plugin",
    "typecheck:site": "next typegen site && tsc --noEmit -p site",
    "typecheck:all": "npm run typecheck && npm run typecheck:scripts && npm run typecheck:plugin && npm run typecheck:mcp && npm run typecheck:site",
    "tokens:palette": "tsx scripts/build-palette.ts",
    "tokens:palette-check": "tsx scripts/build-palette.ts --check",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "tokens:check": "tsx scripts/build-tokens.ts --check",
    "tokens:lint-values": "tsx scripts/lint-raw-values.ts",
    "tokens:lint-naming": "tsx scripts/lint-token-naming.ts",
    "tokens:lint-bridge": "tsx scripts/lint-theme-bridge.ts",
    "tokens:lint-focus": "tsx scripts/lint-focus-ring.ts",
    "tokens:lint-contrast": "tsx scripts/lint-contrast.ts",
    "tokens:test-rebrand": "tsx scripts/test-rebrand.ts",
    "tokens:lint-lifecycle": "tsx scripts/lint-token-lifecycle.ts",
    "tokens:lint-monotonic": "tsx scripts/lint-palette-monotonic.ts",
    "tokens:lint-chart": "tsx scripts/lint-chart-palette.ts",
    "tokens:lint-fonts": "tsx scripts/lint-font-tokens.ts",
    "tokens:lint-dtcg": "tsx scripts/lint-dtcg.ts",
    "index:schema": "tsx scripts/validate-index.ts",
    "index:sizes": "tsx scripts/lint-sizes.ts",
    "index:data-slot": "tsx scripts/lint-data-slot.ts",
    "index:validate": "npm run index:schema && npm run index:sizes && npm run index:data-slot && npm run index:strings && npm run index:props && npm run index:shadcn",
    "specs:variants": "tsx scripts/build-spec-variants.ts",
    "specs:tokens": "tsx scripts/build-spec-tokens.ts",
    "specs:api": "tsx scripts/build-spec-api.ts",
    "specs:states": "tsx scripts/build-spec-states.ts",
    "specs:choices": "tsx scripts/build-spec-choices.ts",
    "specs:validate": "tsx scripts/test-spec-classes.ts && tsx scripts/build-spec-variants.ts --check && tsx scripts/build-spec-tokens.ts --check && tsx scripts/build-spec-api.ts --check && tsx scripts/build-spec-states.ts --check && tsx scripts/build-spec-choices.ts --check && tsx scripts/lint-spec-sections.ts && tsx scripts/lint-spec-anatomy.ts && tsx scripts/lint-spec-wording.ts && tsx scripts/lint-foundation-examples.ts && tsx scripts/build-llms-txt.ts --check",
    "skills:validate": "tsx scripts/validate-skills.ts",
    "docs:tokens": "tsx scripts/build-token-docs.ts",
    "registry:build": "tsx scripts/build-registry.ts",
    "registry:check": "tsx scripts/build-registry.ts --check",
    "registry:validate": "shadcn registry validate ./registry.json",
    "registry:test-install": "tsx scripts/test-registry-install.ts",
    "docs:tokens:check": "tsx scripts/build-token-docs.ts --check",
    "docs:llms": "tsx scripts/build-llms-txt.ts",
    "docs:llms:check": "tsx scripts/build-llms-txt.ts --check",
    "tokens-validate": "npm run tokens:palette-check && npm run tokens:check && npm run tokens:lint-dtcg && npm run tokens:lint-naming && npm run tokens:lint-values && npm run tokens:lint-bridge && npm run tokens:lint-focus && npm run tokens:lint-contrast && npm run tokens:test-rebrand && npm run tokens:lint-monotonic && npm run tokens:lint-chart && npm run tokens:lint-fonts && npm run tokens:lint-lifecycle && npm run docs:tokens:check",
    "mcp:start": "npm --prefix mcp-server run start",
    "mcp:start:http": "npm --prefix mcp-server run start:http",
    "mcp:test": "npm --prefix mcp-server run test",
    "mcp:test-package": "npm --prefix mcp-server run test:package",
    "generate-context": "npm --prefix mcp-server run generate-context && tsx scripts/build-plugin-deprecations.ts",
    "plugin:test": "npm run test -w @dsaireadable/eslint-plugin",
    "test:components": "vitest run",
    "evals": "tsx evals/run.ts",
    "evals:test": "tsx evals/run.ts --self-test",
    "evals:generate": "tsx evals/generate-claude-code.ts",
    "test:lint-coverage": "tsx scripts/lint-test-coverage.ts",
    "test": "npm run test:components && npm run plugin:test && npm run mcp:test",
    "check": "tsx scripts/check.ts",
    "site:dev": "next dev site",
    "site:build": "next build site",
    "site:test": "tsx scripts/test-site.ts",
    "site:examples": "tsx scripts/build-site-examples.ts",
    "site:check": "tsx scripts/build-site-examples.ts --check && tsx scripts/lint-site.ts",
    "prepare": "husky",
    "index:strings": "tsx scripts/lint-ui-strings.ts",
    "index:props": "tsx scripts/lint-props-types.ts",
    "index:shadcn": "tsx scripts/lint-shadcn-api.ts",
    "shadcn:baseline": "tsx scripts/lint-shadcn-api.ts --update",
    "shadcn:retokenize": "tsx scripts/retokenize-codemod.ts",
    "shadcn:drift": "tsx scripts/retokenize-codemod.ts --drift",
    "versions:sync": "tsx scripts/sync-versions.ts",
    "versions:check": "tsx scripts/sync-versions.ts --check",
    "changesets:lint": "tsx scripts/lint-changesets.ts",
    "release:check": "npm run versions:check && npm run changesets:lint",
    "release:version": "changeset version && npm run versions:sync && npm run docs:llms && npm run generate-context && prettier --write CHANGELOG.md",
    "release:test": "tsx scripts/test-release.ts && tsx scripts/test-pinned-install.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "next": "16.3.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@modelcontextprotocol/client": "^2.2.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@terrazzo/cli": "^2.7.1",
    "@terrazzo/parser": "^2.7.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/browser-playwright": "^5.0.3",
    "ajv": "^8.20.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.7",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
