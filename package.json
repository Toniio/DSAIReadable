{
  "name": "dsaireadable",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:mcp": "tsc --noEmit -p mcp-server",
    "typecheck:all": "npm run typecheck && npm run typecheck:scripts && npm run typecheck:mcp",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "tokens:check": "tsx scripts/build-tokens.ts --check",
    "tokens:lint-values": "tsx scripts/lint-raw-values.ts",
    "tokens:lint-naming": "tsx scripts/lint-token-naming.ts",
    "tokens:lint-bridge": "tsx scripts/lint-theme-bridge.ts",
    "tokens:lint-focus": "tsx scripts/lint-focus-ring.ts",
    "tokens:lint-contrast": "tsx scripts/lint-contrast.ts",
    "tokens:lint-lifecycle": "tsx scripts/lint-token-lifecycle.ts",
    "tokens:lint-monotonic": "tsx scripts/lint-palette-monotonic.ts",
    "tokens:lint-chart": "tsx scripts/lint-chart-palette.ts",
    "tokens:lint-fonts": "tsx scripts/lint-font-tokens.ts",
    "index:schema": "tsx scripts/validate-index.ts",
    "index:sizes": "tsx scripts/lint-sizes.ts",
    "index:data-slot": "tsx scripts/lint-data-slot.ts",
    "index:validate": "npm run index:schema && npm run index:sizes && npm run index:data-slot && npm run index:strings && npm run index:props",
    "specs:variants": "tsx scripts/build-spec-variants.ts",
    "specs:tokens": "tsx scripts/build-spec-tokens.ts",
    "specs:api": "tsx scripts/build-spec-api.ts",
    "specs:validate": "tsx scripts/build-spec-variants.ts --check && tsx scripts/build-spec-tokens.ts --check && tsx scripts/build-spec-api.ts --check && tsx scripts/lint-spec-sections.ts",
    "docs:tokens": "tsx scripts/build-token-docs.ts",
    "registry:build": "tsx scripts/build-registry.ts",
    "registry:check": "tsx scripts/build-registry.ts --check",
    "registry:validate": "shadcn registry validate ./registry.json",
    "registry:test-install": "tsx scripts/test-registry-install.ts",
    "docs:tokens:check": "tsx scripts/build-token-docs.ts --check",
    "tokens-validate": "npm run tokens:check && npm run tokens:lint-naming && npm run tokens:lint-values && npm run tokens:lint-bridge && npm run tokens:lint-focus && npm run tokens:lint-contrast && npm run tokens:lint-monotonic && npm run tokens:lint-chart && npm run tokens:lint-fonts && npm run tokens:lint-lifecycle && npm run docs:tokens:check",
    "mcp:start": "npm --prefix mcp-server run start",
    "mcp:start:http": "npm --prefix mcp-server run start:http",
    "mcp:test": "npm --prefix mcp-server run test",
    "generate-context": "npm --prefix mcp-server run generate-context",
    "test": "npm run mcp:test",
    "prepare": "husky",
    "index:strings": "tsx scripts/lint-ui-strings.ts",
    "index:props": "tsx scripts/lint-props-types.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/node": "^4.2.4",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
